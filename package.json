{
  "name": "zocomputer-mcp-ts",
  "version": "0.1.0",
  "description": "Unofficial TypeScript MCP client for programmatic usage of Zo Computer's tools over the streamable HTTP transport",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tools.json": "./openapi/mcp-tools.json"
  },
  "files": [
    "dist",
    "openapi/mcp-tools.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "sync:mcp": "tsx ./scripts/generate.ts",
    "check": "npm run sync:mcp && npm run build",
    "prepublishOnly": "npm run build",
    "docs": "typedoc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EthanThatOneKid/zocomputer-mcp-ts.git"
  },
  "keywords": [
    "zo",
    "zocomputer",
    "mcp",
    "model-context-protocol",
    "unofficial",
    "typescript",
    "api-client"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/EthanThatOneKid/zocomputer-mcp-ts/issues"
  },
  "homepage": "https://github.com/EthanThatOneKid/zocomputer-mcp-ts#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22",
    "json-schema-to-typescript": "^15.0.4",
    "ts-morph": "^26.0.0",
    "tsx": "^4.19.0",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  }
}
